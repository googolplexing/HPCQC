# =============================================================================
# lumi-hpc-qc Experiment Configuration
# =============================================================================
#
# This file defines the EXPERIMENT — physics model, ansatz, optimizer, etc.
# Deployment paths (container, account, partition) are in env.sh, NOT here.
#
# Usage:
#   sbatch tests/test_byo_tfim_8q.sh   (for pre-built experiments)
#   # or copy this template and customize:
#   cp configs/experiment.yaml.example configs/my_experiment.yaml
#   # edit my_experiment.yaml, then:
#   SINGULARITYENV_CONFIG_PATH=configs/my_experiment.yaml sbatch tests/test_byo_tfim_8q.sh
# =============================================================================

# ── Physics Model ──
# Available: fermi_hubbard, heisenberg, qaoa_maxcut, molecular, byo
model: byo
model_params:
  hamiltonian_file: examples/byo_transverse_ising_8q.json
  # FH example:     lattice_rows: 2, lattice_cols: 3, hopping_t: 1.0, interaction_u: 2.0
  # Heis example:   lattice_rows: 3, lattice_cols: 4, jx: 1.0, jy: 1.0, jz: 1.0
  # QAOA example:   num_nodes: 12, graph_type: random_regular, degree: 3, seed: 42
  # Molecular:      molecule: H2, basis: sto-3g, distance: 0.735, num_electrons: 2

# ── Ansatz ──
# Available: su2, hva, qaoa, uccsd, byo
ansatz: su2
ansatz_params:
  reps: 3
  entanglement: linear    # su2 only: linear, circular, full

# ── Optimizer ──
# Available: l_bfgs_b, cobyla, spsa
optimizer: l_bfgs_b
optimizer_params:
  maxiter: 800
  gtol: 1.0e-6            # l_bfgs_b only
  # rhobeg: 0.3           # cobyla only

# ── Gradient ──
# Available: parameter_shift, finite_difference, none
# Auto-selected from ansatz metadata if set to "auto"
gradient: parameter_shift

# ── Initializer ──
# Available: random, zero, adiabatic
# "auto" uses ansatz preferred_initializer
initializer: random
initializer_params:
  seed: 42
  # Adiabatic-specific:
  # adiabatic_steps: 20
  # adiabatic_max_iter: 300

# ── Backend ──
# Available: aer_gpu, aer_cpu, iqm_qpu
backend: aer_gpu
backend_params:
  method: statevector      # statevector, density_matrix, matrix_product_state

# ── Precision ──
# double (default) or single (for >30 qubits)
precision: double

# ── Checkpointing ──
checkpoint:
  enabled: true
  directory: checkpoints
  interval: 50             # save every N iterations

# ── Output ──
output_dir: results
